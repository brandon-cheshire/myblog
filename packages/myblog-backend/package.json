{
    "name": "myblog-backend",
    "version": "1.0.0",
    "description": "Backend API server",
    "type": "module",
    "main": "src/server.ts",
    "scripts": {
        "build": "tsc",
        "check": "prettier --check .",
        "dev": "nodemon --exec tsx src/server.ts",
        "format": "prettier --write .",
        "lint": "cd ../.. && eslint packages/myblog-backend",
        "migrate": "tsx src/database/migrate.ts",
        "seed": "tsx src/database/scripts/seed.ts",
        "start": "nodemon --exec tsx src/server.ts",
        "test": "echo \"Error: no test specified\" && exit 1"
    },
    "nodemonConfig": {
        "watch": ["src"],
        "ext": "ts,js,json",
        "ignore": ["node_modules", "*.test.ts"],
        "delay": 500
    },
    "dependencies": {
        "@myblog/shared": "file:../myblog-shared",
        "@ts-rest/express": "^3.52.1",
        "@types/qrcode": "^1.5.6",
        "@types/speakeasy": "^2.0.10",
        "bcrypt": "^6.0.0",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "dotenv": "^16.6.1",
        "envalid": "^8.1.1",
        "express": "^4.21.2",
        "jsonwebtoken": "^9.0.2",
        "kysely": "^0.28.9",
        "minio": "^8.0.6",
        "multer": "^2.0.2",
        "pg": "^8.16.3",
        "qrcode": "^1.5.4",
        "speakeasy": "^2.0.0",
        "pino": "^9.6.0",
        "pino-http": "^10.3.0",
        "zod": "^3.25.76"
    },
    "devDependencies": {
        "@types/bcrypt": "^5.0.2",
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.5",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/multer": "^2.0.0",
        "@types/node": "^22.19.0",
        "@types/pg": "^8.10.9",
        "nodemon": "^3.1.11",
        "pino-pretty": "^13.0.0",
        "prettier": "^3.6.2",
        "tsx": "^4.20.6",
        "typescript": "^5.7.2"
    }
}
