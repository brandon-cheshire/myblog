{
  "name": "myblog",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "author": "Brandon Cheshire",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=myblog-backend\" \"npm run dev --workspace=myblog-frontend\"",
    "format": "prettier --write .",
    "knip": "npx knip",
    "lint": "eslint .",
    "migrate": "npm run migrate --workspace=myblog-backend",
    "seed": "npm run seed --workspace=myblog-backend",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
    "knip": "^5.81.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "prettier-plugin-packagejson": "^3.0.0",
    "typescript-eslint": "^8.45.0"
  }
}
